<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>CHAMADAN AVENZO — Premium Collection</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #080808;
    color: #fff;
}

/* HEADER */
header {
    padding: 28px 20px;
    text-align: center;
    border-bottom: 1px solid #2d2d2d;
    background: #090909;
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    color: #d4af37;
    font-size: 27px;
    font-weight: 700;
    letter-spacing: 5px;
}

.tagline {
    color: #888;
    margin-top: 8px;
    font-size: 13px;
    letter-spacing: 2px;
}

/* HERO */
.hero {
    min-height: 430px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 70px 20px;
    background:
        radial-gradient(circle at center, #24200f 0%, #0b0b0b 45%, #080808 75%);
}

.hero-content {
    max-width: 800px;
}

.hero h1 {
    font-size: clamp(38px, 8vw, 75px);
    letter-spacing: 4px;
    line-height: 1.05;
    margin-bottom: 20px;
}

.gold {
    color: #d4af37;
}

.hero p {
    color: #aaa;
    font-size: 16px;
    line-height: 1.7;
    max-width: 620px;
    margin: auto;
}

.hero-button {
    display: inline-block;
    margin-top: 30px;
    padding: 14px 32px;
    border: 1px solid #d4af37;
    border-radius: 30px;
    color: #d4af37;
    text-decoration: none;
    font-weight: bold;
    transition: .3s;
}

.hero-button:hover {
    background: #d4af37;
    color: #080808;
}

/* COLLECTION */
.collection {
    max-width: 1400px;
    margin: auto;
    padding: 70px 20px;
}

.section-title {
    text-align: center;
    margin-bottom: 45px;
}

.section-title h2 {
    font-size: 34px;
    letter-spacing: 2px;
}

.section-title p {
    color: #777;
    margin-top: 10px;
}

/* PRODUCTS */
.products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 24px;
}

.card {
    background: linear-gradient(145deg, #181818, #0e0e0e);
    border: 1px solid #292929;
    border-radius: 18px;
    overflow: hidden;
    transition: .35s;
}

.card:hover {
    transform: translateY(-8px);
    border-color: #d4af37;
    box-shadow: 0 15px 45px rgba(212,175,55,.12);
}

.card-image {
    width: 100%;
    height: 350px;
    overflow: hidden;
    background: #111;
}

.card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: .5s;
}

.card:hover img {
    transform: scale(1.05);
}

.card-content {
    padding: 22px;
    text-align: center;
}

.card-content h3 {
    font-size: 20px;
    margin-bottom: 8px;
}

.card-content p {
    color: #888;
    margin-bottom: 18px;
}

.button {
    display: inline-block;
    padding: 11px 25px;
    border-radius: 30px;
    background: #d4af37;
    color: #111;
    text-decoration: none;
    font-weight: bold;
    transition: .3s;
}

.button:hover {
    background: #fff;
}

/* ABOUT */
.about {
    padding: 75px 20px;
    text-align: center;
    background: #0d0d0d;
    border-top: 1px solid #222;
    border-bottom: 1px solid #222;
}

.about-box {
    max-width: 750px;
    margin: auto;
}

.about h2 {
    font-size: 32px;
    margin-bottom: 20px;
}

.about p {
    color: #999;
    line-height: 1.8;
}

/* CONTACT */
.contact {
    text-align: center;
    padding: 65px 20px;
}

.contact h2 {
    font-size: 30px;
    margin-bottom: 15px;
}

.contact p {
    color: #888;
    margin-bottom: 25px;
}

/* FOOTER */
footer {
    padding: 30px 20px;
    text-align: center;
    border-top: 1px solid #292929;
    color: #666;
    font-size: 13px;
}

footer strong {
    color: #d4af37;
}

/* MOBILE */
@media (max-width: 600px) {
    .logo {
        font-size: 21px;
        letter-spacing: 3px;
    }

    .hero {
        min-height: 390px;
        padding: 55px 18px;
    }

    .hero h1 {
        font-size: 40px;
    }

    .collection {
        padding: 50px 15px;
    }

    .products {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .card-image {
        height: 230px;
    }

    .card-content {
        padding: 15px 8px;
    }

    .card-content h3 {
        font-size: 15px;
    }

    .card-content p {
        font-size: 13px;
    }

    .button {
        padding: 9px 15px;
        font-size: 12px;
    }
}
</style>
</head>

